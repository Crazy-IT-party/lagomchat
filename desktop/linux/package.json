{
  "name": "lagomchat",
  "productName": "LagomChat",
  "version": "0.10.0",
  "description": "LagomChat: the chat's page in a window of its own (Linux)",
  "homepage": "https://github.com/Crazy-IT-party/lagomchat",
  "author": "LagomChat <noreply@lagom.game>",
  "license": "Apache-2.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "node stamp.js && electron-builder --linux AppImage deb",
    "release": "LAGOM_REPO= npm run build -- --x64"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "game.lagom.chat",
    "productName": "LagomChat",
    "artifactName": "LagomChat_${version}_${arch}.${ext}",
    "files": ["main.js", "preload.js", "picker-preload.js", "picker.html", "start.html", "icon.png", "stamp.json"],
    "directories": { "output": "out", "buildResources": "res" },
    "appImage": { "artifactName": "LagomChat_${version}_amd64.${ext}" },
    "linux": { "category": "Network;InstantMessaging", "icon": "res/icons", "executableName": "lagomchat", "maintainer": "LagomChat <noreply@lagom.game>" }
  }
}
